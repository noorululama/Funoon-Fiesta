# Google Cloud Console > OAuth client ID (type: Web application)
# Add your site origin and http://localhost:3000 under Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gemini AI assistant fallback key (server-only; can also be configured in Admin > Settings > AI Assistant)
GEMINI_API_KEY=

# Required by the app for local development
MONGODB_URI=mongodb://127.0.0.1:27017/fest_app

# Supabase Storage for admin poster-template uploads (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_POSTER_BUCKET=poster-templates

# Optional: consistent neural male voice for spoken answers (Azure AI Speech).
# Without these server-only values, answers remain available as text and captions.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
